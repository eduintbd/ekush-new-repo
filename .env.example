# ─── Postgres (shared with ekush-web) ──────────────────────────────
# DATABASE_URL: pooler connection (Supabase: port 6543, ?pgbouncer=true)
# DIRECT_URL:   direct connection (Supabase: port 5432) — needed by prisma migrate / db push
DATABASE_URL=""
DIRECT_URL=""

# ─── Supabase Auth (same project as ekush-web) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Cron auth (Vercel-only; skip for local dev) ───────────────────
CRON_SECRET=""

# ─── Optional: real Ekush Web investor API ─────────────────────────
# Leave blank during Phase 1-2 — the mock client kicks in automatically.
EKUSH_WEB_API_BASE=""
EKUSH_WEB_API_TOKEN=""

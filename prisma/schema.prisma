// X-System (ekush-erp) — back-office accounting + selling-agent module
// for Ekush Wealth Management Limited (the AMC, not the funds it manages).
//
// Models below are derived from the project brief in
// docs/X_System_Claude_Code_Prompt.docx §5. All tables live in the
// `xsystem` schema so this codebase can co-tenant in the same Postgres
// as ekush-web (which owns `public.*`) without name collisions.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["xsystem"]
}

// ─── Auth bridge ─────────────────────────────────────────────────
// auth.users lives in Supabase's managed schema; we mirror id + role here.
// One Supabase user → one Profile. Role gates which portal they may access.

enum UserRole {
  admin
  accountant
  selling_agent
  auditor

  @@schema("xsystem")
}

model Profile {
  id        String   @id @db.Uuid // mirrors auth.users.id
  email     String   @unique
  fullName  String?  @map("full_name")
  role      UserRole
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent SellingAgent? @relation("AgentProfile")

  @@map("profiles")
  @@schema("xsystem")
}

// ─── Accounting (back-office) ────────────────────────────────────

// Account groups (Tally-style): hierarchical buckets that classify
// chart-of-accounts entries for financial-statement rollups. Examples:
// "Assets > Current assets > Cash and bank balances", "Liabilities >
// Current liabilities > Accruals", "Income > Operating income".
//
// `nature` drives statement placement: ASSET/LIABILITY/EQUITY land on
// the Balance Sheet; INCOME/EXPENSE on the Income Statement.

enum GroupNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@schema("xsystem")
}

model AccountGroup {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @unique
  parentId    String?     @map("parent_id") @db.Uuid
  nature      GroupNature
  /// Display order within siblings (lower = earlier).
  sortOrder   Int         @default(0) @map("sort_order")
  description String?
  isReserved  Boolean     @default(false) @map("is_reserved") // seeded vs user-created
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  parent   AccountGroup?    @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountGroup[]   @relation("GroupHierarchy")
  accounts ChartOfAccount[]

  @@index([parentId])
  @@map("account_groups")
  @@schema("xsystem")
}

model ChartOfAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sl            Int
  name          String   @unique // FK target for Journal.accountName
  normalBalance String   @map("normal_balance") // 'DEBIT' | 'CREDIT'
  category      String?
  /// FK to AccountGroup. Nullable during migration; new accounts must set it.
  groupId       String?  @map("group_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  group           AccountGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  journals        Journal[]
  openingBalances AccountOpeningBalance[]
  bankAccount     BankAccount?            @relation("BankAccountToCoA")

  @@index([sl])
  @@index([groupId])
  @@map("chart_of_accounts")
  @@schema("xsystem")
}

model FiscalYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String    @unique // 'FY2025-26'
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  journals             Journal[]
  investments          InvestmentHolding[]
  openingBalances      AccountOpeningBalance[]
  depreciationEntries  FixedAssetDepreciation[]
  employeeDisclosure   EmployeeDisclosure?
  bankStatements       BankStatement[]
  trades               Trade[]
  fairValueAdjustments FairValueAdjustment[]
  taxProvisions        TaxProvision[]

  @@map("fiscal_years")
  @@schema("xsystem")
}

// Snapshot of one investment position as at `asOfDate`. Backs the
// Annexure-B (Investments) sheet of the year-end workbook and the
// `/annexures` page. Aggregate sums per category should match the
// matching TB-C investment accounts (investmentEfuf, investmentInShare,
// etc.) — divergence indicates an unposted fair-value journal.
enum InvestmentCategory {
  listed_securities
  open_end_mutual_funds
  ipo_subscription
  ipo_applications
  private_placements

  @@schema("xsystem")
}

model InvestmentHolding {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId      String             @map("fiscal_year_id") @db.Uuid
  asOfDate          DateTime           @map("as_of_date") @db.Date
  category          InvestmentCategory
  instrumentName    String             @map("instrument_name")
  quantity          Decimal            @db.Decimal(18, 4)
  avgCostPerUnit    Decimal            @map("avg_cost_per_unit") @db.Decimal(18, 4)
  marketRatePerUnit Decimal?           @map("market_rate_per_unit") @db.Decimal(18, 4)
  notes             String?
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([fiscalYearId, asOfDate])
  @@index([category])
  @@map("investment_holdings")
  @@schema("xsystem")
}

// ─── Trade ledger + price feed ───────────────────────────────────
// `Instrument` is the master ticker registry. Every Trade and Price row
// references one. `investmentAccount` tells the auto-journal generator
// which CoA account a buy/sell on this instrument debits/credits on the
// investment leg (listed equities → 'Investment in share', mutual-fund
// units → 'Investment in Mutual Fund(E.F.U.F)' / (E.G.F) / (S.R.F),
// private placements → 'Investment In Placement Shares', etc.).

enum InstrumentCategory {
  listed_security
  mutual_fund_open
  private_placement
  ipo_application
  bond

  @@schema("xsystem")
}

model Instrument {
  code              String             @id // 'BRACBANK', 'EFUF', 'APSCLBOND'
  name              String // 'BRAC Bank Ltd'
  category          InstrumentCategory
  /// Free-text industry / sector classification — Banks, Mutual Fund,
  /// Pharma, Tobacco, Telecom, Bond, etc. Shown on /prices and exported
  /// in the portfolio xlsx so the Pinki sheet can group by sector.
  sector            String?
  isin              String?
  /// CoA account name posted to on the investment leg of a Trade. FK target
  /// is ChartOfAccount.name (validated at seed time, not enforced as FK to
  /// allow soft references and renames via onUpdate: Cascade pattern).
  investmentAccount String             @map("investment_account")
  faceValue         Decimal            @default(10) @map("face_value") @db.Decimal(18, 2)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  trades   Trade[]
  prices   Price[]
  fvaLines FairValueAdjustmentLine[]

  @@map("instruments")
  @@schema("xsystem")
}

enum TradeSide {
  BUY
  SELL

  @@schema("xsystem")
}

// Broker master — admin-managed via /admin/brokers. The AMC has two
// today (UCB Securities, Prime Bank Securities Ltd) and may add more
// (e.g. ICB) without a code change. Each broker links to its
// settlement ledgers in the CoA.
model Broker {
  /// Stable short code used as FK target by Trade.brokerCode.
  /// UPPERCASE letters/digits/underscore. 'UCB', 'PRIMEBANK', etc.
  code              String   @id
  name              String // 'UCB Securities', 'Prime Bank Securities Ltd'
  /// Broker's BO account number (e.g. 'UCB 1205590068173895'). Shown
  /// next to the broker name on the /trades/new dropdown and in the
  /// auto-journal description so audit knows which BO settled the
  /// trade. Nullable — Pinki can add a broker before she has the BO
  /// number assigned.
  accountNumber     String?  @map("account_number")
  /// CoA account name of the broker's BO / current-account ledger
  /// (DEBIT-normal). Required — every broker has a settlement target.
  brokerBoAccount   String   @map("broker_bo_account")
  /// CoA account name of the margin-loan liability ledger
  /// (CREDIT-normal). Optional — some brokers don't extend margin.
  marginLoanAccount String?  @map("margin_loan_account")
  isActive          Boolean  @default(true) @map("is_active")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  trades Trade[]

  @@map("brokers")
  @@schema("xsystem")
}

model Trade {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeDate      DateTime  @map("trade_date") @db.Date
  fiscalYearId   String    @map("fiscal_year_id") @db.Uuid
  instrumentCode String    @map("instrument_code")
  side           TradeSide
  /// FK to Broker.code. Nullable on historical backfill rows
  /// (workbook didn't carry the broker column); required on new
  /// trades typed via /trades/new.
  brokerCode     String?   @map("broker_code")
  quantity       Decimal   @db.Decimal(18, 4)
  rate           Decimal   @db.Decimal(18, 6)
  grossAmount    Decimal   @map("gross_amount") @db.Decimal(18, 2)
  /// Broker commission charged on this trade, BDT. Defaults to 0
  /// (free / no-fee). On BUY it's CAPITALIZED into cost basis:
  /// settlement leg credits gross+commission, investment leg debits
  /// gross+commission. On SELL it's NETTED from proceeds: settlement
  /// leg debits gross−commission; realised P&L = (gross−commission)
  /// − costBasis. Per IFRS 9 / IAS 39 transaction-cost handling for
  /// FVOCI assets.
  commission     Decimal   @default(0) @map("commission") @db.Decimal(18, 2)
  /// CoA account name of the settlement ledger this trade clears against
  /// (bank, broker BO, margin loan, or mobile-money account). Required
  /// dropdown on /trades/new; sourced from active BankAccount rows.
  /// Column name stayed `bank_account` for backwards compatibility.
  bankAccount    String    @map("bank_account")
  /// Snapshot of weighted-average cost basis at the time of sale; null on
  /// BUY rows. Used by the auto-journal generator to compute the credit
  /// leg of the investment account.
  costBasis      Decimal?  @map("cost_basis") @db.Decimal(18, 2)
  /// Realised P&L on a SELL trade = grossAmount − costBasis. Positive =
  /// gain (cr on `Realised Gain/(Loss) on Investments`); negative = loss.
  realisedPnl    Decimal?  @map("realised_pnl") @db.Decimal(18, 2)
  /// Auto-posted journal batch id. Idempotency lock — generator skips
  /// if non-null. Voucher prefix 'BV' for buys, 'SV' for sells.
  journalBatchId String?   @map("journal_batch_id") @db.Uuid
  remarks        String?
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentCode], references: [code], onDelete: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  broker     Broker?    @relation(fields: [brokerCode], references: [code], onDelete: Restrict)

  @@index([tradeDate])
  @@index([instrumentCode, tradeDate])
  @@index([fiscalYearId])
  @@index([journalBatchId])
  @@index([brokerCode])
  @@map("trades")
  @@schema("xsystem")
}

model Price {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instrumentCode String   @map("instrument_code")
  priceDate      DateTime @map("price_date") @db.Date
  closePrice     Decimal  @map("close_price") @db.Decimal(18, 4)
  notes          String?
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  instrument Instrument @relation(fields: [instrumentCode], references: [code], onDelete: Restrict)

  @@unique([instrumentCode, priceDate])
  @@index([priceDate])
  @@map("prices")
  @@schema("xsystem")
}

// Fair-value-through-P&L marker. One row per revaluation event (admin
// clicks "Revalue to market" on /portfolio). Each row links to the
// compound journal voucher that posted the unrealised gain/loss. Re-
// running for the same `asOfDate` reverses the prior FVA and posts a
// new one — `(fiscalYearId, asOfDate)` is unique to enforce idempotency.
model FairValueAdjustment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asOfDate       DateTime  @map("as_of_date") @db.Date
  fiscalYearId   String    @map("fiscal_year_id") @db.Uuid
  journalBatchId String    @map("journal_batch_id") @db.Uuid
  totalCost      Decimal   @map("total_cost") @db.Decimal(18, 2)
  totalMarket    Decimal   @map("total_market") @db.Decimal(18, 2)
  unrealisedPnl  Decimal   @map("unrealised_pnl") @db.Decimal(18, 2)
  /// Set when this FVA has been superseded by a later run for the same
  /// asOfDate. Reversed FVAs stay in the table for audit; the active one
  /// has `reversedAt IS NULL`.
  reversedAt     DateTime? @map("reversed_at")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  fiscalYear FiscalYear                @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines      FairValueAdjustmentLine[]

  @@index([fiscalYearId, asOfDate])
  @@map("fair_value_adjustments")
  @@schema("xsystem")
}

// Per-instrument snapshot for one FairValueAdjustment. Captures the
// cumulative unrealised gain on each priced holding AT POST-TIME, so a
// future marginal-delta computation reads from a frozen baseline and
// is immune to retroactive price entries / trade backfills. `deltaPosted`
// is the signed amount actually posted to the journal for this
// instrument on this FVA — the sum of deltas across lines equals the
// FairValueAdjustment's journal Fair-Value-Reserve net.
model FairValueAdjustmentLine {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustmentId            String   @map("adjustment_id") @db.Uuid
  instrumentCode          String   @map("instrument_code")
  quantity                Decimal  @db.Decimal(18, 4)
  totalCost               Decimal  @map("total_cost") @db.Decimal(18, 2)
  marketRate              Decimal  @map("market_rate") @db.Decimal(18, 4)
  marketValue             Decimal  @map("market_value") @db.Decimal(18, 2)
  /// Cumulative unrealised gain on this instrument at the FVA's asOfDate.
  cumulativeUnrealisedPnl Decimal  @map("cumulative_unrealised_pnl") @db.Decimal(18, 2)
  /// Signed delta posted to this instrument's investmentAccount on this
  /// FVA. Sum across all lines equals the offsetting Fair Value Reserve
  /// amount in the matching journal voucher.
  deltaPosted             Decimal  @map("delta_posted") @db.Decimal(18, 2)
  createdAt               DateTime @default(now()) @map("created_at")

  adjustment FairValueAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  instrument Instrument          @relation(fields: [instrumentCode], references: [code], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([instrumentCode])
  @@map("fair_value_adjustment_lines")
  @@schema("xsystem")
}

// ─── Tax Provision ───────────────────────────────────────────────
// Statutory tax rates per type, valid from a given date forward. The
// "current" rate for a given asOfDate is the row with the largest
// effectiveFrom <= asOfDate. Replaces the hard-coded 0.15 / 0.20 /
// 0.15 constants previously inlined in src/lib/statement_mapping.ts —
// IS computation now reads rates from this table so admins can edit
// statutory rates without a code change, and historical periods
// recompute with the rate that was active then.
model TaxRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jurisdiction  String   @default("BD")
  // CAPITAL_GAIN | DIVIDEND | INTEREST | DEFERRED | MGMT_FEE
  // (MGMT_FEE is optional; the workbook treats this at-source so it
  // may be entered as an amount instead of computed via rate × revenue.)
  rateType      String   @map("rate_type")
  value         Decimal  @db.Decimal(6, 4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  // Free-text statutory reference, e.g. "BD Finance Act 2024 s.82C".
  // Surfaced on the admin card next to the rate input.
  note          String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([jurisdiction, rateType, effectiveFrom])
  @@map("tax_rates")
  @@schema("xsystem")
}

// Reporting period for tax computation. A period is OPEN until an
// admin locks it; locking freezes the rates used + the journal entry
// posted and prevents recomputation. Reopening requires a role check
// + audit log entry. Often co-incides with FiscalYear but allowed to
// be a sub-period (e.g. quarter-end) so quarterly returns can lock
// independently of the FY close.
model TaxPeriod {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  // OPEN | LOCKED
  status    String    @default("OPEN")
  lockedAt  DateTime? @map("locked_at")
  lockedBy  String?   @map("locked_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  provisions TaxProvision[]

  @@unique([startDate, endDate])
  @@index([status])
  @@map("tax_periods")
  @@schema("xsystem")
}

// One TaxProvision row per (period, fiscalYear, computedAt) — the
// canonical record of "what was the statutory tax expense at the
// moment the admin clicked Save / Post". status=DRAFT means
// computation only; POSTED means a top-up journal has been written;
// SUPERSEDED means a later computation replaced this one (kept for
// audit). ratesSnapshot + basesSnapshot are jsonb so historical
// provisions remain auditable even if the underlying rate / journal
// changes later.
model TaxProvision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId      String   @map("period_id") @db.Uuid
  fiscalYearId  String   @map("fiscal_year_id") @db.Uuid
  computedAt    DateTime @default(now()) @map("computed_at")
  computedBy    String?  @map("computed_by") @db.Uuid

  // Current-tax components (Notes 13.01 H99..H102).
  currentTaxCg       Decimal @map("current_tax_cg") @db.Decimal(18, 2)
  currentTaxDividend Decimal @map("current_tax_dividend") @db.Decimal(18, 2)
  currentTaxInterest Decimal @map("current_tax_interest") @db.Decimal(18, 2)
  currentTaxMgmt     Decimal @map("current_tax_mgmt") @db.Decimal(18, 2)
  /// (Business Income − Business Expenses) × CORPORATE rate.
  currentTaxBusiness Decimal @default(0) @map("current_tax_business") @db.Decimal(18, 2)
  currentTaxTotal    Decimal @map("current_tax_total") @db.Decimal(18, 2)

  // Deferred tax (OCI, Notes 13.01 H107..H108).
  deferredTaxTotal Decimal @map("deferred_tax_total") @db.Decimal(18, 2)

  // Reconciliation vs whatever's already accrued in journals.
  // varianceCurrent = currentTaxTotal − netC(Provision for Income Tax) at compute-time.
  varianceCurrent  Decimal @map("variance_current") @db.Decimal(18, 2)
  varianceDeferred Decimal @map("variance_deferred") @db.Decimal(18, 2)

  // Frozen inputs at the moment of computation, for audit replay.
  ratesSnapshot Json @map("rates_snapshot")
  basesSnapshot Json @map("bases_snapshot")

  // DRAFT | POSTED | SUPERSEDED
  status String @default("DRAFT")

  period     TaxPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  postings   TaxPosting[]

  @@index([periodId, status])
  @@index([fiscalYearId])
  @@map("tax_provisions")
  @@schema("xsystem")
}

// Link table: one row per top-up journal posted for a given
// provision. Multiple postings allowed when rates change mid-period
// and the admin re-runs — each new top-up is incremental (current
// computed − Σ all prior top-ups for the same period).
model TaxPosting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provisionId    String   @map("provision_id") @db.Uuid
  journalBatchId String   @map("journal_batch_id") @db.Uuid
  postedAt       DateTime @default(now()) @map("posted_at")
  postedBy       String?  @map("posted_by") @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  // CURRENT_TAX_TOPUP | DEFERRED_TAX_TOPUP | REVERSAL
  type           String

  provision TaxProvision @relation(fields: [provisionId], references: [id], onDelete: Restrict)

  @@index([provisionId])
  @@index([journalBatchId])
  @@map("tax_postings")
  @@schema("xsystem")
}

// Opening balance per account per fiscal year — feeds Notes 10, 12,
// 12.02, 14, 15.01, 24 rollforward sections. Trial balance for the
// period closes by adding journal activity on top of this.
model AccountOpeningBalance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId  String   @map("fiscal_year_id") @db.Uuid
  accountName   String   @map("account_name")
  openingDebit  Decimal  @default(0) @map("opening_debit") @db.Decimal(18, 2)
  openingCredit Decimal  @default(0) @map("opening_credit") @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  account    ChartOfAccount @relation(fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@unique([fiscalYearId, accountName])
  @@index([fiscalYearId])
  @@map("account_opening_balances")
  @@schema("xsystem")
}

// Asset classes used by the PPE register (Note 4 / Note 22 / Annexure-A).
// Mirrors the chart-of-accounts split: computers (r7), office decoration
// (r8), office equipment (r9). 'other' is an escape hatch.
enum AssetClass {
  computers
  office_decoration
  office_equipment
  other

  @@schema("xsystem")
}

// PPE register — one row per asset. Aggregate `cost` and
// `accumulatedDepreciation` per class drive Note 4; per-class
// FixedAssetDepreciation rows for the FY drive Note 22.
model FixedAsset {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetClass              AssetClass @map("asset_class")
  name                    String
  acquiredOn              DateTime   @map("acquired_on") @db.Date
  cost                    Decimal    @db.Decimal(18, 2)
  /// Running closing balance — opening + sum(FixedAssetDepreciation)
  /// across all FYs. Operator updates at FY-close.
  accumulatedDepreciation Decimal    @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  depreciationRatePctPa   Decimal?   @map("depreciation_rate_pct_pa") @db.Decimal(5, 2)
  disposedOn              DateTime?  @map("disposed_on") @db.Date
  notes                   String?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  depreciations FixedAssetDepreciation[]

  @@index([assetClass])
  @@map("fixed_assets")
  @@schema("xsystem")
}

// Depreciation charged to one asset in one fiscal year. Per-class sums
// for a given FY = Note 22 row values.
model FixedAssetDepreciation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId String   @map("fiscal_year_id") @db.Uuid
  fixedAssetId String   @map("fixed_asset_id") @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  asset      FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, fixedAssetId])
  @@index([fiscalYearId])
  @@map("fixed_asset_depreciations")
  @@schema("xsystem")
}

// Shareholder register — backs Note 11 (Share Capital) and supplies
// the share count for Notes 25 (EPS) and 26 (NAV per share). A single
// table, not fiscal-year-scoped — shareholders change rarely. Set
// `isActive = false` to remove a shareholder while preserving history.
model Shareholder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName   String   @map("full_name")
  sharesHeld Int      @map("shares_held")
  isActive   Boolean  @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("shareholders")
  @@schema("xsystem")
}

// Note 27: employee minimum-pay disclosure. One row per fiscal year.
model EmployeeDisclosure {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId        String   @unique @map("fiscal_year_id") @db.Uuid
  totalEmployees      Int      @map("total_employees")
  belowMinimumWage    Int      @default(0) @map("below_minimum_wage")
  minMonthlySalaryBdt Decimal  @map("min_monthly_salary_bdt") @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@map("employee_disclosures")
  @@schema("xsystem")
}

model Journal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryDate      DateTime @map("entry_date") @db.Date
  description    String?
  txnType        String?  @map("txn_type") // 'OB','c','j', etc.
  /// Human-readable voucher number, shared across all lines of a batch.
  /// Format: '{PREFIX}/{FY}/{####}' where PREFIX is JV / OB / RV / PV / CV
  /// and FY is the short fiscal-year label e.g. '25-26'. Backfilled on
  /// existing batches; new vouchers get one allocated at createJournal time.
  voucherNo      String?  @map("voucher_no")
  accountName    String   @map("account_name")
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  fiscalYearId   String   @map("fiscal_year_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  /// Stock ticker for dividend lines (Note 19.01) or bank-account code for
  /// interest-income lines (Note 20). Free-form; the note builder groups by it.
  /// Auto-stamped by the trade engine + portfolio FVA revaluation.
  instrumentCode String?  @map("instrument_code")
  /// NBR challan reference for AIT/TDS entries. Populated on mgmt-fee
  /// receipt vouchers where the fund withholds TDS on EWML's behalf —
  /// used to evidence the AIT claim at AY assessment time.
  challanNo      String?  @map("challan_no")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account    ChartOfAccount @relation(fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  agent      SellingAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([entryDate])
  @@index([accountName])
  @@index([fiscalYearId])
  @@index([batchId])
  @@index([voucherNo])
  @@map("journals")
  @@schema("xsystem")
}

// ─── Selling-agent (commission engine) ───────────────────────────

enum AgentStatus {
  pending
  approved
  suspended
  terminated

  @@schema("xsystem")
}

model SellingAgent {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique // 'SB0001'
  fullName   String      @map("full_name")
  email      String      @unique
  phone      String?
  status     AgentStatus @default(pending)
  userId     String?     @unique @map("user_id") @db.Uuid // FK to Profile.id once approved
  approvedAt DateTime?   @map("approved_at")
  approvedBy String?     @map("approved_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  profile        Profile?            @relation("AgentProfile", fields: [userId], references: [id], onDelete: SetNull)
  terms          AgentTerm[]
  investors      AgentInvestor[]
  commissionRuns CommissionRun[]
  accruals       CommissionAccrual[]
  journals       Journal[]

  @@map("selling_agents")
  @@schema("xsystem")
}

enum FundCategory {
  equity
  fixed_income

  @@schema("xsystem")
}

model AgentTerm {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String       @map("agent_id") @db.Uuid
  fundCategory     FundCategory @map("fund_category")
  upfrontPct       Decimal      @map("upfront_pct") @db.Decimal(6, 4) // 0.0020 = 0.20%
  trailY1PctPa     Decimal      @map("trail_y1_pct_pa") @db.Decimal(6, 4)
  trailY2PlusPctPa Decimal      @map("trail_y2plus_pct_pa") @db.Decimal(6, 4)
  trailFrequency   String       @default("quarterly") @map("trail_frequency")
  clawbackMonths   Int          @default(6) @map("clawback_months")
  clawbackPct      Decimal      @default(1.0000) @map("clawback_pct") @db.Decimal(5, 4)
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  effectiveTo      DateTime?    @map("effective_to") @db.Date
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  agent SellingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, fundCategory, effectiveFrom])
  @@map("agent_terms")
  @@schema("xsystem")
}

model AgentInvestor {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId              String   @map("agent_id") @db.Uuid
  investorCode         String   @map("investor_code") // matches Ekush Web
  fundCode             String   @map("fund_code") // 'EFUF','EGF','ESRF'
  sourcedOn            DateTime @map("sourced_on") @db.Date
  initialUnits         Decimal  @map("initial_units") @db.Decimal(18, 4)
  initialGrossAmount   Decimal  @map("initial_gross_amount") @db.Decimal(18, 2)
  unitPriceAtSourcing  Decimal  @map("unit_price_at_sourcing") @db.Decimal(10, 4)
  isDirectSubscription Boolean  @default(false) @map("is_direct_subscription")
  createdAt            DateTime @default(now()) @map("created_at")

  agent          SellingAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commissionRuns CommissionRun[]

  @@unique([investorCode, fundCode, sourcedOn])
  @@index([agentId])
  @@map("agent_investors")
  @@schema("xsystem")
}

model NavSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundCode     String   @map("fund_code")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  unitNav      Decimal  @map("unit_nav") @db.Decimal(10, 4)
  source       String   @default("manual")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fundCode, snapshotDate])
  @@map("nav_snapshots")
  @@schema("xsystem")
}

enum CommissionType {
  upfront
  trail
  clawback

  @@schema("xsystem")
}

enum CommissionStatus {
  accrued
  approved
  paid
  reversed

  @@schema("xsystem")
}

model CommissionRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId         String           @map("agent_id") @db.Uuid
  agentInvestorId String?          @map("agent_investor_id") @db.Uuid
  type            CommissionType
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  baseAmount      Decimal          @map("base_amount") @db.Decimal(18, 2)
  rateApplied     Decimal          @map("rate_applied") @db.Decimal(8, 6)
  amount          Decimal          @db.Decimal(18, 2)
  status          CommissionStatus @default(accrued)
  paidOn          DateTime?        @map("paid_on") @db.Date
  journalBatchId  String?          @map("journal_batch_id") @db.Uuid
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  agent         SellingAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentInvestor AgentInvestor? @relation(fields: [agentInvestorId], references: [id], onDelete: SetNull)

  // Idempotency for the quarterly run job
  @@unique([agentInvestorId, type, periodStart, periodEnd], name: "uniq_run_period")
  @@index([agentId, status])
  @@map("commission_runs")
  @@schema("xsystem")
}

// Daily snapshot fed by the cron job that produces the agent dashboard's
// "accrued today" / "this quarter to date" numbers. Reconciled against
// CommissionRun rows at quarter close.
model CommissionAccrual {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String   @map("agent_id") @db.Uuid
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  upfrontTodayBdt  Decimal  @default(0) @map("upfront_today_bdt") @db.Decimal(18, 2)
  trailTodayBdt    Decimal  @default(0) @map("trail_today_bdt") @db.Decimal(18, 2)
  quarterToDateBdt Decimal  @default(0) @map("quarter_to_date_bdt") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  agent SellingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, snapshotDate])
  @@map("commission_accruals")
  @@schema("xsystem")
}

// ─── MFA recovery codes ──────────────────────────────────────────
// Single-use backup codes that let a user regain access if they lose
// their TOTP device. On match, the recovery flow uses the Supabase
// service-role client to unenrol all of the user's MFA factors and
// signs them out; they then re-enrol on next sign-in.
//
// Codes are stored as bcrypt hashes — never in plaintext. The plaintext
// is shown to the user once at generation and never again.

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid // mirrors auth.users.id
  codeHash  String    @map("code_hash")
  /// Set when the code is redeemed. NULL = still available.
  usedAt    DateTime? @map("used_at")
  /// Optional convenience marker so the UI can show "code #3 was used".
  label     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
  @@schema("xsystem")
}

// ─── Bank account master ─────────────────────────────────────────
// Structured bank-ledger metadata. References a CoA name (1:1) so the
// account behaves like any other ledger for journals, but carries
// banking-specific fields (account number, bank, branch, IFSC, BRS
// start date) that don't belong on every CoA row.

enum BankAccountType {
  current
  savings
  std
  md
  fdr
  mobile_money
  other

  @@schema("xsystem")
}

model BankAccount {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// References ChartOfAccount.name. Each bank ledger maps to exactly one
  /// CoA row; the CoA `name` is the human label everyone uses.
  accountName         String          @unique @map("account_name")
  bankName            String          @map("bank_name") // e.g. "BRAC Bank Limited"
  branch              String?
  accountNumber       String          @map("account_number")
  accountType         BankAccountType @default(current) @map("account_type")
  currency            String          @default("BDT")
  ifsc                String?
  swift               String?
  /// Opening balance from the bank's books at the system go-live date.
  /// Used to seed BRS calculations; NOT a journal entry.
  openingBalance      Decimal         @default(0) @map("opening_balance") @db.Decimal(18, 2)
  /// Date from which BRS reconciliation tracking starts — earlier
  /// transactions are assumed cleared.
  reconciliationStart DateTime?       @map("reconciliation_start") @db.Date
  isActive            Boolean         @default(true) @map("is_active")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  account ChartOfAccount @relation("BankAccountToCoA", fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@map("bank_accounts")
  @@schema("xsystem")
}

// ─── Bank Reconciliation ─────────────────────────────────────────
// One BankStatement per (cash/bank account, period) imported from the
// bank's xlsx/csv. Each line is matched against journal lines via
// `matchedJournalId` (null = unmatched). The BRS = (book balance) +
// outstanding deposits - outstanding cheques = (statement balance).

model BankStatement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Chart-of-accounts name — the AMC's bank/cash account this statement covers.
  accountName    String   @map("account_name")
  fiscalYearId   String   @map("fiscal_year_id") @db.Uuid
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 2)
  closingBalance Decimal  @default(0) @map("closing_balance") @db.Decimal(18, 2)
  /// Optional source-file metadata (filename, blob URL, etc.).
  sourceFile     String?  @map("source_file")
  notes          String?
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines      BankStatementLine[]

  @@unique([accountName, periodStart, periodEnd])
  @@index([fiscalYearId])
  @@map("bank_statements")
  @@schema("xsystem")
}

model BankStatementLine {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId      String    @map("statement_id") @db.Uuid
  lineDate         DateTime  @map("line_date") @db.Date
  description      String?
  refNo            String?   @map("ref_no")
  /// Bank-side: positive amount means the bank credited the AMC (deposit).
  amount           Decimal   @db.Decimal(18, 2)
  runningBalance   Decimal?  @map("running_balance") @db.Decimal(18, 2)
  matchedJournalId String?   @unique @map("matched_journal_id") @db.Uuid
  clearedOn        DateTime? @map("cleared_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([lineDate])
  @@map("bank_statement_lines")
  @@schema("xsystem")
}

// ─── Fund management-fee imports ─────────────────────────────────
// Cross-system verification table: for each (fund, period) we pull the
// AMC's recorded management-fee income from the fund's FIN_STATS xlsx
// (Journals sheet, account = 'Management Fee') and compare against what
// X-System has booked. Accountant verifies and can override the
// computed amount via `manualAmount`.

enum MgmtFeeStatus {
  imported
  reviewed
  verified

  @@schema("xsystem")
}

model ManagementFeeImport {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundCode       String        @map("fund_code") // 'EFUF', 'EGF', 'ESRF'
  periodStart    DateTime      @map("period_start") @db.Date
  periodEnd      DateTime      @map("period_end") @db.Date
  /// Sum of fund's 'Management Fee' debits in (periodStart, periodEnd).
  computedAmount Decimal       @map("computed_amount") @db.Decimal(18, 2)
  /// Accountant override; falls back to computedAmount when null.
  manualAmount   Decimal?      @map("manual_amount") @db.Decimal(18, 2)
  status         MgmtFeeStatus @default(imported)
  /// upload row id from public.daily_fund_uploads the import was sourced from.
  sourceUploadId String?       @map("source_upload_id")
  sourceFileName String?       @map("source_file_name")
  notes          String?
  importedAt     DateTime      @default(now()) @map("imported_at")
  importedBy     String?       @map("imported_by") @db.Uuid
  verifiedAt     DateTime?     @map("verified_at")
  verifiedBy     String?       @map("verified_by") @db.Uuid
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([fundCode, periodStart, periodEnd])
  @@index([fundCode])
  @@map("management_fee_imports")
  @@schema("xsystem")
}

// ─── Audit ───────────────────────────────────────────────────────
// Trigger-fed log of every mutation on journals, agent_terms,
// commission_runs, fiscal_years. Auditors will ask for it.

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actor       String?  @db.Uuid
  action      String // 'journal.create','journal.update','agent.approve', etc.
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?

  @@index([at])
  @@index([action])
  @@index([targetTable, targetId])
  @@map("audit_log")
  @@schema("xsystem")
}

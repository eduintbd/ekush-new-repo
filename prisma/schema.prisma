// X-System (ekush-erp) — back-office accounting + selling-agent module
// for Ekush Wealth Management Limited (the AMC, not the funds it manages).
//
// Models below are derived from the project brief in
// docs/X_System_Claude_Code_Prompt.docx §5. All tables live in the
// `xsystem` schema so this codebase can co-tenant in the same Postgres
// as ekush-web (which owns `public.*`) without name collisions.

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["xsystem"]
}

// ─── Auth bridge ─────────────────────────────────────────────────
// auth.users lives in Supabase's managed schema; we mirror id + role here.
// One Supabase user → one Profile. Role gates which portal they may access.

enum UserRole {
  admin
  accountant
  selling_agent
  auditor

  @@schema("xsystem")
}

model Profile {
  id        String   @id @db.Uuid // mirrors auth.users.id
  email     String   @unique
  fullName  String?  @map("full_name")
  role      UserRole
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent SellingAgent? @relation("AgentProfile")

  @@map("profiles")
  @@schema("xsystem")
}

// ─── Accounting (back-office) ────────────────────────────────────

// Account groups (Tally-style): hierarchical buckets that classify
// chart-of-accounts entries for financial-statement rollups. Examples:
// "Assets > Current assets > Cash and bank balances", "Liabilities >
// Current liabilities > Accruals", "Income > Operating income".
//
// `nature` drives statement placement: ASSET/LIABILITY/EQUITY land on
// the Balance Sheet; INCOME/EXPENSE on the Income Statement.

enum GroupNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@schema("xsystem")
}

model AccountGroup {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String       @unique
  parentId     String?      @map("parent_id") @db.Uuid
  nature       GroupNature
  /// Display order within siblings (lower = earlier).
  sortOrder    Int          @default(0) @map("sort_order")
  description  String?
  isReserved   Boolean      @default(false) @map("is_reserved") // seeded vs user-created
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  parent   AccountGroup?    @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AccountGroup[]   @relation("GroupHierarchy")
  accounts ChartOfAccount[]

  @@index([parentId])
  @@map("account_groups")
  @@schema("xsystem")
}

model ChartOfAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sl            Int
  name          String   @unique // FK target for Journal.accountName
  normalBalance String   @map("normal_balance") // 'DEBIT' | 'CREDIT'
  category      String?
  /// FK to AccountGroup. Nullable during migration; new accounts must set it.
  groupId       String?  @map("group_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  group           AccountGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  journals        Journal[]
  openingBalances AccountOpeningBalance[]
  bankAccount     BankAccount?            @relation("BankAccountToCoA")

  @@index([sl])
  @@index([groupId])
  @@map("chart_of_accounts")
  @@schema("xsystem")
}

model FiscalYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String    @unique // 'FY2025-26'
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  journals            Journal[]
  investments         InvestmentHolding[]
  openingBalances     AccountOpeningBalance[]
  depreciationEntries FixedAssetDepreciation[]
  employeeDisclosure  EmployeeDisclosure?
  bankStatements      BankStatement[]

  @@map("fiscal_years")
  @@schema("xsystem")
}

// Snapshot of one investment position as at `asOfDate`. Backs the
// Annexure-B (Investments) sheet of the year-end workbook and the
// `/annexures` page. Aggregate sums per category should match the
// matching TB-C investment accounts (investmentEfuf, investmentInShare,
// etc.) — divergence indicates an unposted fair-value journal.
enum InvestmentCategory {
  listed_securities
  open_end_mutual_funds
  ipo_subscription
  ipo_applications
  private_placements

  @@schema("xsystem")
}

model InvestmentHolding {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId      String             @map("fiscal_year_id") @db.Uuid
  asOfDate          DateTime           @map("as_of_date") @db.Date
  category          InvestmentCategory
  instrumentName    String             @map("instrument_name")
  quantity          Decimal            @db.Decimal(18, 4)
  avgCostPerUnit    Decimal            @map("avg_cost_per_unit") @db.Decimal(18, 4)
  marketRatePerUnit Decimal?           @map("market_rate_per_unit") @db.Decimal(18, 4)
  notes             String?
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([fiscalYearId, asOfDate])
  @@index([category])
  @@map("investment_holdings")
  @@schema("xsystem")
}

// Opening balance per account per fiscal year — feeds Notes 10, 12,
// 12.02, 14, 15.01, 24 rollforward sections. Trial balance for the
// period closes by adding journal activity on top of this.
model AccountOpeningBalance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId  String   @map("fiscal_year_id") @db.Uuid
  accountName   String   @map("account_name")
  openingDebit  Decimal  @default(0) @map("opening_debit") @db.Decimal(18, 2)
  openingCredit Decimal  @default(0) @map("opening_credit") @db.Decimal(18, 2)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  account    ChartOfAccount @relation(fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@unique([fiscalYearId, accountName])
  @@index([fiscalYearId])
  @@map("account_opening_balances")
  @@schema("xsystem")
}

// Asset classes used by the PPE register (Note 4 / Note 22 / Annexure-A).
// Mirrors the chart-of-accounts split: computers (r7), office decoration
// (r8), office equipment (r9). 'other' is an escape hatch.
enum AssetClass {
  computers
  office_decoration
  office_equipment
  other

  @@schema("xsystem")
}

// PPE register — one row per asset. Aggregate `cost` and
// `accumulatedDepreciation` per class drive Note 4; per-class
// FixedAssetDepreciation rows for the FY drive Note 22.
model FixedAsset {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetClass              AssetClass @map("asset_class")
  name                    String
  acquiredOn              DateTime   @map("acquired_on") @db.Date
  cost                    Decimal    @db.Decimal(18, 2)
  /// Running closing balance — opening + sum(FixedAssetDepreciation)
  /// across all FYs. Operator updates at FY-close.
  accumulatedDepreciation Decimal    @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  depreciationRatePctPa   Decimal?   @map("depreciation_rate_pct_pa") @db.Decimal(5, 2)
  disposedOn              DateTime?  @map("disposed_on") @db.Date
  notes                   String?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  depreciations FixedAssetDepreciation[]

  @@index([assetClass])
  @@map("fixed_assets")
  @@schema("xsystem")
}

// Depreciation charged to one asset in one fiscal year. Per-class sums
// for a given FY = Note 22 row values.
model FixedAssetDepreciation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId String   @map("fiscal_year_id") @db.Uuid
  fixedAssetId String   @map("fixed_asset_id") @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  asset      FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, fixedAssetId])
  @@index([fiscalYearId])
  @@map("fixed_asset_depreciations")
  @@schema("xsystem")
}

// Shareholder register — backs Note 11 (Share Capital) and supplies
// the share count for Notes 25 (EPS) and 26 (NAV per share). A single
// table, not fiscal-year-scoped — shareholders change rarely. Set
// `isActive = false` to remove a shareholder while preserving history.
model Shareholder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName   String   @map("full_name")
  sharesHeld Int      @map("shares_held")
  isActive   Boolean  @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("shareholders")
  @@schema("xsystem")
}

// Note 27: employee minimum-pay disclosure. One row per fiscal year.
model EmployeeDisclosure {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fiscalYearId        String   @unique @map("fiscal_year_id") @db.Uuid
  totalEmployees      Int      @map("total_employees")
  belowMinimumWage    Int      @default(0) @map("below_minimum_wage")
  minMonthlySalaryBdt Decimal  @map("min_monthly_salary_bdt") @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@map("employee_disclosures")
  @@schema("xsystem")
}

model Journal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryDate      DateTime @map("entry_date") @db.Date
  description    String?
  txnType        String?  @map("txn_type") // 'OB','c','j', etc.
  /// Human-readable voucher number, shared across all lines of a batch.
  /// Format: '{PREFIX}/{FY}/{####}' where PREFIX is JV / OB / RV / PV / CV
  /// and FY is the short fiscal-year label e.g. '25-26'. Backfilled on
  /// existing batches; new vouchers get one allocated at createJournal time.
  voucherNo      String?  @map("voucher_no")
  accountName    String   @map("account_name")
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  fiscalYearId   String   @map("fiscal_year_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  investorCode   String?  @map("investor_code")
  agentId        String?  @map("agent_id") @db.Uuid
  fundCode       String?  @map("fund_code") // 'EFUF','EGF','ESRF'
  /// Cost-centre tag (FK to CostCentre.code, soft — string for portability).
  /// `fundCode` was the implicit cost dimension before we added formal cost
  /// centres; `costCentreCode` is the explicit one for non-fund dimensions
  /// like ADMIN, MARKETING, etc.
  costCentreCode String?  @map("cost_centre_code")
  /// Stock ticker for dividend lines (Note 19.01) or bank-account code for
  /// interest-income lines (Note 20). Free-form; the note builder groups by it.
  instrumentCode String?  @map("instrument_code")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account    ChartOfAccount @relation(fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  agent      SellingAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([entryDate])
  @@index([accountName])
  @@index([fiscalYearId])
  @@index([batchId])
  @@index([voucherNo])
  @@index([costCentreCode])
  @@map("journals")
  @@schema("xsystem")
}

// ─── Selling-agent (commission engine) ───────────────────────────

enum AgentStatus {
  pending
  approved
  suspended
  terminated

  @@schema("xsystem")
}

model SellingAgent {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String      @unique // 'SB0001'
  fullName   String      @map("full_name")
  email      String      @unique
  phone      String?
  status     AgentStatus @default(pending)
  userId     String?     @unique @map("user_id") @db.Uuid // FK to Profile.id once approved
  approvedAt DateTime?   @map("approved_at")
  approvedBy String?     @map("approved_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  profile        Profile?            @relation("AgentProfile", fields: [userId], references: [id], onDelete: SetNull)
  terms          AgentTerm[]
  investors      AgentInvestor[]
  commissionRuns CommissionRun[]
  accruals       CommissionAccrual[]
  journals       Journal[]

  @@map("selling_agents")
  @@schema("xsystem")
}

enum FundCategory {
  equity
  fixed_income

  @@schema("xsystem")
}

model AgentTerm {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String       @map("agent_id") @db.Uuid
  fundCategory     FundCategory @map("fund_category")
  upfrontPct       Decimal      @map("upfront_pct") @db.Decimal(6, 4) // 0.0020 = 0.20%
  trailY1PctPa     Decimal      @map("trail_y1_pct_pa") @db.Decimal(6, 4)
  trailY2PlusPctPa Decimal      @map("trail_y2plus_pct_pa") @db.Decimal(6, 4)
  trailFrequency   String       @default("quarterly") @map("trail_frequency")
  clawbackMonths   Int          @default(6) @map("clawback_months")
  clawbackPct      Decimal      @default(1.0000) @map("clawback_pct") @db.Decimal(5, 4)
  effectiveFrom    DateTime     @map("effective_from") @db.Date
  effectiveTo      DateTime?    @map("effective_to") @db.Date
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  agent SellingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, fundCategory, effectiveFrom])
  @@map("agent_terms")
  @@schema("xsystem")
}

model AgentInvestor {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId              String   @map("agent_id") @db.Uuid
  investorCode         String   @map("investor_code") // matches Ekush Web
  fundCode             String   @map("fund_code") // 'EFUF','EGF','ESRF'
  sourcedOn            DateTime @map("sourced_on") @db.Date
  initialUnits         Decimal  @map("initial_units") @db.Decimal(18, 4)
  initialGrossAmount   Decimal  @map("initial_gross_amount") @db.Decimal(18, 2)
  unitPriceAtSourcing  Decimal  @map("unit_price_at_sourcing") @db.Decimal(10, 4)
  isDirectSubscription Boolean  @default(false) @map("is_direct_subscription")
  createdAt            DateTime @default(now()) @map("created_at")

  agent          SellingAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commissionRuns CommissionRun[]

  @@unique([investorCode, fundCode, sourcedOn])
  @@index([agentId])
  @@map("agent_investors")
  @@schema("xsystem")
}

model NavSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundCode     String   @map("fund_code")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  unitNav      Decimal  @map("unit_nav") @db.Decimal(10, 4)
  source       String   @default("manual")
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fundCode, snapshotDate])
  @@map("nav_snapshots")
  @@schema("xsystem")
}

enum CommissionType {
  upfront
  trail
  clawback

  @@schema("xsystem")
}

enum CommissionStatus {
  accrued
  approved
  paid
  reversed

  @@schema("xsystem")
}

model CommissionRun {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId         String           @map("agent_id") @db.Uuid
  agentInvestorId String?          @map("agent_investor_id") @db.Uuid
  type            CommissionType
  periodStart     DateTime?        @map("period_start") @db.Date
  periodEnd       DateTime?        @map("period_end") @db.Date
  baseAmount      Decimal          @map("base_amount") @db.Decimal(18, 2)
  rateApplied     Decimal          @map("rate_applied") @db.Decimal(8, 6)
  amount          Decimal          @db.Decimal(18, 2)
  status          CommissionStatus @default(accrued)
  paidOn          DateTime?        @map("paid_on") @db.Date
  journalBatchId  String?          @map("journal_batch_id") @db.Uuid
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  agent         SellingAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentInvestor AgentInvestor? @relation(fields: [agentInvestorId], references: [id], onDelete: SetNull)

  // Idempotency for the quarterly run job
  @@unique([agentInvestorId, type, periodStart, periodEnd], name: "uniq_run_period")
  @@index([agentId, status])
  @@map("commission_runs")
  @@schema("xsystem")
}

// Daily snapshot fed by the cron job that produces the agent dashboard's
// "accrued today" / "this quarter to date" numbers. Reconciled against
// CommissionRun rows at quarter close.
model CommissionAccrual {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId          String   @map("agent_id") @db.Uuid
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  upfrontTodayBdt  Decimal  @default(0) @map("upfront_today_bdt") @db.Decimal(18, 2)
  trailTodayBdt    Decimal  @default(0) @map("trail_today_bdt") @db.Decimal(18, 2)
  quarterToDateBdt Decimal  @default(0) @map("quarter_to_date_bdt") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  agent SellingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, snapshotDate])
  @@map("commission_accruals")
  @@schema("xsystem")
}

// ─── MFA recovery codes ──────────────────────────────────────────
// Single-use backup codes that let a user regain access if they lose
// their TOTP device. On match, the recovery flow uses the Supabase
// service-role client to unenrol all of the user's MFA factors and
// signs them out; they then re-enrol on next sign-in.
//
// Codes are stored as bcrypt hashes — never in plaintext. The plaintext
// is shown to the user once at generation and never again.

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid // mirrors auth.users.id
  codeHash  String    @map("code_hash")
  /// Set when the code is redeemed. NULL = still available.
  usedAt    DateTime? @map("used_at")
  /// Optional convenience marker so the UI can show "code #3 was used".
  label     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
  @@schema("xsystem")
}

// ─── Bank account master ─────────────────────────────────────────
// Structured bank-ledger metadata. References a CoA name (1:1) so the
// account behaves like any other ledger for journals, but carries
// banking-specific fields (account number, bank, branch, IFSC, BRS
// start date) that don't belong on every CoA row.

enum BankAccountType {
  current
  savings
  std
  md
  fdr
  mobile_money
  other

  @@schema("xsystem")
}

model BankAccount {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// References ChartOfAccount.name. Each bank ledger maps to exactly one
  /// CoA row; the CoA `name` is the human label everyone uses.
  accountName          String          @unique @map("account_name")
  bankName             String          @map("bank_name") // e.g. "BRAC Bank Limited"
  branch               String?
  accountNumber        String          @map("account_number")
  accountType          BankAccountType @default(current) @map("account_type")
  currency             String          @default("BDT")
  ifsc                 String?
  swift                String?
  /// Opening balance from the bank's books at the system go-live date.
  /// Used to seed BRS calculations; NOT a journal entry.
  openingBalance       Decimal         @default(0) @map("opening_balance") @db.Decimal(18, 2)
  /// Date from which BRS reconciliation tracking starts — earlier
  /// transactions are assumed cleared.
  reconciliationStart  DateTime?       @map("reconciliation_start") @db.Date
  isActive             Boolean         @default(true) @map("is_active")
  notes                String?
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  account ChartOfAccount @relation("BankAccountToCoA", fields: [accountName], references: [name], onUpdate: Cascade, onDelete: Restrict)

  @@map("bank_accounts")
  @@schema("xsystem")
}

// ─── Cost centres ────────────────────────────────────────────────
// Tally-style cost-centre masters for dimensional reporting. Optional
// hierarchy via parent_id. Tag a journal line with `costCentreCode` to
// enable per-cost-centre P&L slicing.

model CostCentre {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique // e.g. 'EFUF', 'EGF', 'ESRF', 'ADMIN', 'MARKETING'
  name        String
  parentId    String?  @map("parent_id") @db.Uuid
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   CostCentre?  @relation("CostCentreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCentre[] @relation("CostCentreHierarchy")

  @@index([parentId])
  @@map("cost_centres")
  @@schema("xsystem")
}

// ─── Bank Reconciliation ─────────────────────────────────────────
// One BankStatement per (cash/bank account, period) imported from the
// bank's xlsx/csv. Each line is matched against journal lines via
// `matchedJournalId` (null = unmatched). The BRS = (book balance) +
// outstanding deposits - outstanding cheques = (statement balance).

model BankStatement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Chart-of-accounts name — the AMC's bank/cash account this statement covers.
  accountName     String   @map("account_name")
  fiscalYearId    String   @map("fiscal_year_id") @db.Uuid
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  openingBalance  Decimal  @default(0) @map("opening_balance") @db.Decimal(18, 2)
  closingBalance  Decimal  @default(0) @map("closing_balance") @db.Decimal(18, 2)
  /// Optional source-file metadata (filename, blob URL, etc.).
  sourceFile      String?  @map("source_file")
  notes           String?
  uploadedBy      String?  @map("uploaded_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fiscalYear FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lines      BankStatementLine[]

  @@unique([accountName, periodStart, periodEnd])
  @@index([fiscalYearId])
  @@map("bank_statements")
  @@schema("xsystem")
}

model BankStatementLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId     String        @map("statement_id") @db.Uuid
  lineDate        DateTime      @map("line_date") @db.Date
  description     String?
  refNo           String?       @map("ref_no")
  /// Bank-side: positive amount means the bank credited the AMC (deposit).
  amount          Decimal       @db.Decimal(18, 2)
  runningBalance  Decimal?      @map("running_balance") @db.Decimal(18, 2)
  matchedJournalId String?      @unique @map("matched_journal_id") @db.Uuid
  clearedOn       DateTime?     @map("cleared_on") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([lineDate])
  @@map("bank_statement_lines")
  @@schema("xsystem")
}

// ─── Fund management-fee imports ─────────────────────────────────
// Cross-system verification table: for each (fund, period) we pull the
// AMC's recorded management-fee income from the fund's FIN_STATS xlsx
// (Journals sheet, account = 'Management Fee') and compare against what
// X-System has booked. Accountant verifies and can override the
// computed amount via `manualAmount`.

enum MgmtFeeStatus {
  imported
  reviewed
  verified

  @@schema("xsystem")
}

model ManagementFeeImport {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundCode        String        @map("fund_code") // 'EFUF', 'EGF', 'ESRF'
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  /// Sum of fund's 'Management Fee' debits in (periodStart, periodEnd).
  computedAmount  Decimal       @map("computed_amount") @db.Decimal(18, 2)
  /// Accountant override; falls back to computedAmount when null.
  manualAmount    Decimal?      @map("manual_amount") @db.Decimal(18, 2)
  status          MgmtFeeStatus @default(imported)
  /// upload row id from public.daily_fund_uploads the import was sourced from.
  sourceUploadId  String?       @map("source_upload_id")
  sourceFileName  String?       @map("source_file_name")
  notes           String?
  importedAt      DateTime      @default(now()) @map("imported_at")
  importedBy      String?       @map("imported_by") @db.Uuid
  verifiedAt      DateTime?     @map("verified_at")
  verifiedBy      String?       @map("verified_by") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([fundCode, periodStart, periodEnd])
  @@index([fundCode])
  @@map("management_fee_imports")
  @@schema("xsystem")
}

// ─── Audit ───────────────────────────────────────────────────────
// Trigger-fed log of every mutation on journals, agent_terms,
// commission_runs, fiscal_years. Auditors will ask for it.

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  actor       String?  @db.Uuid
  action      String // 'journal.create','journal.update','agent.approve', etc.
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?

  @@index([at])
  @@index([action])
  @@index([targetTable, targetId])
  @@map("audit_log")
  @@schema("xsystem")
}
